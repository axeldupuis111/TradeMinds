# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (mode test)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (mode test)
NEXT_PUBLIC_STRIPE_PRICE_PLUS_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_PLUS_YEARLY=price_...

# Encryption (AES-256-GCM) for exchange & broker API credentials
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Cron jobs (Vercel) — Bearer secret protecting /api/send-reminders,
# /api/weekly-report, /api/sync/brokers, etc.
CRON_SECRET=

# Tradovate API — app identifiers sent on every auth request.
# These describe THIS application, not the user (user creds are stored encrypted
# per-connection). appId/version are arbitrary identifying strings.
TRADOVATE_APP_ID=TradeDiscipline
TRADOVATE_APP_VERSION=1.0
